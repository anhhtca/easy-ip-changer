import { Theme } from "../theme.slint";
import { PrimaryButton } from "../components/buttons.slint";

export component PrivilegeScreen inherits VerticalLayout {
    in property <string> error-message: "";
    callback request-elevation();

    alignment: center;
    padding: 32px;
    spacing: 20px;

    HorizontalLayout {
        alignment: center;

        Rectangle {
            width: 68px;
            height: 68px;
            border-radius: 34px;
            background: Theme.warning-bg;
            border-width: 1px;
            border-color: Theme.warning-border;

            Image {
                source: @image-url("../icons/shield.svg");
                width: 32px;
                height: 32px;
                colorize: Theme.warning;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }

    VerticalLayout {
        spacing: 10px;
        alignment: center;

        Text {
            text: "Cần quyền Quản trị để đổi địa chỉ IP";
            color: Theme.text-primary;
            font-size: 20px;
            font-weight: 700;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Text {
            text: "Windows yêu cầu quyền Quản trị (Administrator) để lưu địa chỉ IP và thứ tự ưu tiên mạng. Hãy bấm nút bên dưới, sau đó chọn \"Yes\" khi hộp thoại xác nhận xuất hiện.";
            color: Theme.text-secondary;
            font-size: 13.5px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    if root.error-message != "": Rectangle {
        border-radius: Theme.radius-sm;
        background: Theme.danger-bg;
        border-width: 1px;
        border-color: Theme.danger-border;

        HorizontalLayout {
            padding: 12px;
            spacing: 10px;
            alignment: start;

            Image {
                source: @image-url("../icons/alert.svg");
                width: 18px;
                height: 18px;
                colorize: Theme.danger;
                vertical-alignment: top;
            }

            Text {
                text: root.error-message;
                color: Theme.danger;
                font-size: 12.5px;
                font-weight: 500;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
    }

    HorizontalLayout {
        alignment: center;
        padding-top: 6px;

        PrimaryButton {
            label: "Mở lại với quyền Quản trị";
            min-width: 240px;
            clicked => { root.request-elevation(); }
        }
    }
}
