import { Theme, NicItem } from "../theme.slint";
import { PrimaryButton, SecondaryButton } from "../components/buttons.slint";

component NicOptionRow inherits Rectangle {
    in property <NicItem> item;
    in property <bool> selected: false;
    in property <bool> recommended: false;
    callback clicked();

    border-radius: Theme.radius-md;
    border-width: root.selected ? 1.5px : 1px;
    border-color: root.selected ? Theme.accent
        : ta.has-hover ? Theme.border-strong
        : Theme.border-subtle;
    background: root.selected ? Theme.bg-selected
        : ta.has-hover ? #FAF7F8
        : Theme.bg-surface;

    animate background { duration: 150ms; easing: ease-out; }
    animate border-color { duration: 150ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 10px;
        alignment: start;

        // Radio indicator
        VerticalLayout {
            alignment: center;
            width: 18px;

            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border-width: root.selected ? 4.5px : 1.5px;
                border-color: root.selected ? Theme.accent : Theme.border-strong;
                background: Theme.bg-surface;
            }
        }

        // Icon badge
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: Theme.radius-sm;
                background: root.selected ? Theme.accent-soft
                    : root.item.is-ethernet ? #F8EBEF
                    : Theme.bg-subtle;

                Image {
                    source: root.item.is-ethernet
                        ? @image-url("../icons/ethernet.svg")
                        : @image-url("../icons/wifi.svg");
                    width: 16px;
                    height: 16px;
                    colorize: root.selected ? Theme.accent
                        : root.item.is-ethernet ? #8F1634
                        : Theme.text-secondary;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        // Info column
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.space-2xs;

            HorizontalLayout {
                spacing: Theme.space-sm;
                alignment: start;

                Text {
                    text: root.item.friendly-name;
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Rectangle {
                    height: 18px;
                    border-radius: Theme.radius-pill;
                    background: Theme.bg-subtle;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        Text {
                            text: root.item.type-label;
                            color: Theme.text-secondary;
                            font-size: 10.5px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.recommended: Rectangle {
                    height: 18px;
                    border-radius: Theme.radius-pill;
                    background: Theme.success-bg;
                    border-width: 1px;
                    border-color: Theme.success-border;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        Text {
                            text: "Nên chọn";
                            color: Theme.success;
                            font-size: 10.5px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Text {
                text: root.item.description;
                color: Theme.text-secondary;
                font-size: 11.5px;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: Theme.space-md;
                alignment: start;
                padding-top: 1px;

                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: root.item.is-connected ? Theme.success-dot : #94A3B8;
                        }
                    }

                    Text {
                        text: root.item.status-text;
                        color: root.item.is-connected ? Theme.success : Theme.text-muted;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "•";
                    color: #CBD5E1;
                    font-size: 11px;
                    vertical-alignment: center;
                }

                Text {
                    text: root.item.ip-summary;
                    color: Theme.text-muted;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component NicSelectScreen inherits VerticalLayout {
    in property <[NicItem]> adapters;
    in-out property <int> selected-index: -1;
    in property <bool> has-ethernet: true;
    in property <string> scan-error: "";

    callback refresh-clicked();
    callback continue-clicked();

    spacing: 0px;

    // Main content
    VerticalLayout {
        vertical-stretch: 1;
        padding-left: Theme.space-xl;
        padding-right: Theme.space-xl;
        padding-top: 14px;
        padding-bottom: 10px;
        spacing: 10px;

        // Title + Refresh
        HorizontalLayout {
            alignment: space-between;
            spacing: 10px;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.space-2xs;

                Text {
                    text: "Chọn kết nối mạng cần đổi IP";
                    color: Theme.text-primary;
                    font-size: 16px;
                    font-weight: 700;
                }

                Text {
                    text: "Ưu tiên chọn kết nối dây Ethernet (kể cả USB Ethernet) nếu máy đang cắm cáp mạng.";
                    color: Theme.text-secondary;
                    font-size: 11.5px;
                    wrap: word-wrap;
                }
            }

            VerticalLayout {
                alignment: start;
                SecondaryButton {
                    label: "Quét lại";
                    height: Theme.btn-compact-height;
                    min-width: 82px;
                    has-leading-icon: true;
                    leading-icon: @image-url("../icons/refresh.svg");
                    clicked => { root.refresh-clicked(); }
                }
            }
        }

        if root.scan-error != "": Rectangle {
            border-radius: Theme.radius-sm;
            background: Theme.danger-bg;
            border-width: 1px;
            border-color: Theme.danger-border;

            HorizontalLayout {
                padding: 9px;
                spacing: Theme.space-md;

                Image {
                    source: @image-url("../icons/alert.svg");
                    width: 15px;
                    height: 15px;
                    colorize: Theme.danger;
                }

                Text {
                    text: root.scan-error;
                    color: Theme.danger;
                    font-size: 11.5px;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
        }

        if root.adapters.length == 0: Rectangle {
            vertical-stretch: 1;
            border-radius: Theme.radius-md;
            background: Theme.bg-surface;
            border-width: 1px;
            border-color: Theme.border-subtle;

            VerticalLayout {
                alignment: center;
                padding: 20px;
                spacing: Theme.space-sm;

                Text {
                    text: "Không tìm thấy kết nối Ethernet hoặc Wi-Fi";
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Hãy kiểm tra dây mạng, đầu chuyển USB Ethernet hoặc bật Wi-Fi trên máy, sau đó bấm \"Quét lại\".";
                    color: Theme.text-secondary;
                    font-size: 11.5px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        if root.adapters.length > 0 && !root.has-ethernet: Rectangle {
            border-radius: Theme.radius-md;
            background: Theme.warning-bg;
            border-width: 1px;
            border-color: Theme.warning-border;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: Theme.space-md;
                alignment: start;

                VerticalLayout {
                    alignment: start;
                    padding-top: 1px;
                    Image {
                        source: @image-url("../icons/alert.svg");
                        width: 15px;
                        height: 15px;
                        colorize: Theme.warning;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Theme.space-2xs;

                    Text {
                        text: "Không tìm thấy kết nối Ethernet nào trên máy";
                        color: #92400E;
                        font-size: 12px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }

                    Text {
                        text: "Hãy kiểm tra lại cáp mạng / đầu chuyển USB Ethernet rồi bấm \"Quét lại\", hoặc chủ động chọn Wi-Fi bên dưới nếu bạn muốn đổi IP cho Wi-Fi.";
                        color: #92400E;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
            }
        }

        if root.adapters.length > 0: Flickable {
            vertical-stretch: 1;
            content-height: list-box.preferred-height;
            content-width: self.width;
            interactive: true;

            list-box := VerticalLayout {
                width: parent.width;
                spacing: 7px;
                padding-bottom: 4px;

                for adapter[idx] in root.adapters: NicOptionRow {
                    item: adapter;
                    selected: idx == root.selected-index;
                    recommended: adapter.is-ethernet && (adapter.is-connected || idx == 0);
                    clicked => { root.selected-index = idx; }
                }
            }
        }
    }

    // Anchored Footer
    Rectangle {
        height: Theme.footer-height;
        background: Theme.bg-surface;

        Rectangle {
            y: 0px;
            height: 1px;
            width: parent.width;
            background: Theme.border-subtle;
        }

        HorizontalLayout {
            padding-left: Theme.space-xl;
            padding-right: Theme.space-xl;
            alignment: space-between;

            Text {
                text: root.adapters.length == 0
                    ? "Chưa có kết nối nào"
                    : root.selected-index < 0
                        ? "Vui lòng chọn một kết nối để tiếp tục"
                        : "Đã tìm thấy " + root.adapters.length + " kết nối vật lý";
                color: root.selected-index < 0 && root.adapters.length > 0 ? Theme.warning : Theme.text-muted;
                font-size: 11.5px;
                font-weight: root.selected-index < 0 && root.adapters.length > 0 ? 600 : 400;
                vertical-alignment: center;
            }

            VerticalLayout {
                alignment: center;
                PrimaryButton {
                    label: "Tiếp tục";
                    enabled: root.adapters.length > 0 && root.selected-index >= 0;
                    has-trailing-icon: true;
                    trailing-icon: @image-url("../icons/arrow-right.svg");
                    clicked => { root.continue-clicked(); }
                }
            }
        }
    }
}
