export struct NicItem {
    if-index: int,
    friendly-name: string,
    description: string,
    type-label: string,
    is-ethernet: bool,
    is-connected: bool,
    status-text: string,
    ip-summary: string,
}

export global Theme {
    // Typography
    out property <string> font-sans: "Be Vietnam Pro";

    // Shell & Surfaces (Agribank Bordeaux #AE1C3F Header + Warm Alabaster Ground)
    out property <color> header-bg: #AE1C3F;
    out property <color> header-bg-elevated: #8F1533;
    out property <color> header-border: #8A1431;
    out property <color> header-line: #CC5B76;
    out property <color> header-text: #FFFFFF;
    out property <color> header-muted: #FAD8E0;
    out property <color> header-step-active: #FFFFFF;

    out property <color> bg-canvas: #F7F5F6;
    out property <color> bg-surface: #FFFFFF;
    out property <color> bg-subtle: #F2EEF0;
    out property <color> bg-readonly: #FAF8F9;
    out property <color> bg-selected: #FDF2F5;

    // Borders
    out property <color> border-subtle: #E6DFE2;
    out property <color> border-strong: #CFC4C8;
    out property <color> border-focus: #AE1C3F;

    // Text Hierarchy
    out property <color> text-primary: #1A1618;
    out property <color> text-secondary: #52494D;
    out property <color> text-muted: #73686D;
    out property <color> text-readonly: #3B3337;

    // Primary Accent (Agribank Bordeaux)
    out property <color> accent: #AE1C3F;
    out property <color> accent-hover: #951735;
    out property <color> accent-pressed: #7A122B;
    out property <color> accent-disabled: #DCA4B2;
    out property <color> accent-soft: #F9DDE4;

    // Semantic States
    out property <color> success: #0D7A5F;
    out property <color> success-bg: #E6F6F0;
    out property <color> success-border: #A7DFCA;
    out property <color> success-dot: #10B981;

    out property <color> warning: #B45309;
    out property <color> warning-bg: #FEF3C7;
    out property <color> warning-border: #FCD34D;

    out property <color> danger: #B91C1C;
    out property <color> danger-bg: #FEF2F2;
    out property <color> danger-border: #FCA5A5;

    // Radii
    out property <length> radius-sm: 5px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 10px;
    out property <length> radius-pill: 999px;

    // Compact Desktop Spacing Scale (4px base with micro steps)
    out property <length> space-2xs: 2px;
    out property <length> space-xs: 4px;
    out property <length> space-sm: 6px;
    out property <length> space-md: 8px;
    out property <length> space-lg: 12px;
    out property <length> space-xl: 16px;

    // Control Dimensions
    out property <length> control-height: 30px;
    out property <length> octet-height: 34px;
    out property <length> btn-height: 32px;
    out property <length> btn-compact-height: 28px;
    out property <length> edit-btn-height: 22px;
    out property <length> footer-height: 48px;
    out property <length> statusbar-height: 24px;
}
