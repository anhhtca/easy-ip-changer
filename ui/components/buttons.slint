import { Theme } from "../theme.slint";

export component PrimaryButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> loading: false;
    in property <image> trailing-icon;
    in property <bool> has-trailing-icon: false;
    callback clicked();

    height: Theme.btn-height;
    min-width: 108px;
    border-radius: Theme.radius-sm;
    background: !root.enabled || root.loading ? Theme.accent-disabled
        : ta.pressed ? Theme.accent-pressed
        : ta.has-hover ? Theme.accent-hover
        : Theme.accent;

    animate background { duration: 150ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: Theme.space-sm;
        alignment: center;

        Text {
            text: root.label;
            color: #FFFFFF;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }

        if root.has-trailing-icon && !root.loading: VerticalLayout {
            alignment: center;
            Image {
                source: root.trailing-icon;
                width: 14px;
                height: 14px;
                colorize: #FFFFFF;
            }
        }
    }

    ta := TouchArea {
        enabled: root.enabled && !root.loading;
        mouse-cursor: root.enabled && !root.loading ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component SecondaryButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <image> leading-icon;
    in property <bool> has-leading-icon: false;
    callback clicked();

    height: Theme.btn-height;
    min-width: 88px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: ta.has-hover && root.enabled ? Theme.border-strong : Theme.border-subtle;
    background: !root.enabled ? Theme.bg-subtle
        : ta.pressed ? #EAE3E6
        : ta.has-hover ? #F5F0F2
        : Theme.bg-surface;

    animate background { duration: 150ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 13px;
        spacing: 5px;
        alignment: center;

        if root.has-leading-icon: VerticalLayout {
            alignment: center;
            Image {
                source: root.leading-icon;
                width: 14px;
                height: 14px;
                colorize: root.enabled ? Theme.text-secondary : Theme.text-muted;
            }
        }

        Text {
            text: root.label;
            color: root.enabled ? Theme.text-primary : Theme.text-muted;
            font-size: 12.5px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component SmallEditButton inherits Rectangle {
    in property <bool> editing: false;
    in property <bool> enabled: true;
    callback clicked();

    height: Theme.edit-btn-height;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: root.editing ? Theme.accent : (ta.has-hover ? Theme.border-strong : Theme.border-subtle);
    background: root.editing ? Theme.bg-selected
        : ta.pressed ? #EAE3E6
        : ta.has-hover ? #F5F0F2
        : Theme.bg-surface;

    animate background { duration: 150ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        spacing: Theme.space-xs;
        alignment: center;

        VerticalLayout {
            alignment: center;
            Image {
                source: root.editing ? @image-url("../icons/lock.svg") : @image-url("../icons/edit.svg");
                width: 11px;
                height: 11px;
                colorize: root.editing ? Theme.accent : Theme.text-secondary;
            }
        }

        Text {
            text: root.editing ? "Khóa" : "Sửa";
            color: root.editing ? Theme.accent : Theme.text-secondary;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}
